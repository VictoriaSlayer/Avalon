datasets/
*.dump
*.backup
*.sql.gz
*.zip

# Obsidian: личные настройки, темы, плагины, конфликты синхронизации
.obsidian/
*.sync-conflict-*

# Мусор системы и редакторов
.DS_Store
Thumbs.db
*~
.trash/
