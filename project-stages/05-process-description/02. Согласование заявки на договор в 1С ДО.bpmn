    <bpmn:textAnnotation id="TextAnnotation_0isqeje">
      <bpmn:text>РП,
Контрольно-аналитический отдел,
Экономический отдел,
Договорной отдел,
Доп. согласующие</bpmn:text>
    </bpmn:textAnnotation>
