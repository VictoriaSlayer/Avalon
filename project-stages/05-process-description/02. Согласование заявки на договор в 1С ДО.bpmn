    <bpmn:textAnnotation id="TextAnnotation_1oqihax">
      <bpmn:text>Инициатор заявки:
- собирает все необходимые документы для согласования;
- создает и отправляет заявку на согласование в 1С ДО;</bpmn:text>
    </bpmn:textAnnotation>
